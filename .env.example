# TMDB API key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Metadata language as a TMDB language code. Field labels switch to Chinese for any
# zh* value and to English otherwise (e.g. zh-CN, en-US).
TMDB_LANGUAGE=zh-CN

# Telegram bot token from @BotFather, and the target channel id (e.g. -1001234567890).
# The bot must be an admin of the channel.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=your_telegram_channel_id

# Optional log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
